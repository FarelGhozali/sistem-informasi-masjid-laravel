---
/**
 * Home — built around the first ten seconds of a cafe visit: where it is,
 * whether it is open, what they serve, and whether you can work there. The
 * location card sits above the fold for that reason.
 */
import { getCollection } from "astro:content";
import CroppedImage from "@studio/core/components/CroppedImage.astro";
import type { ImageMetadata } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@studio/core/components/Container.astro";
import Button from "@studio/core/components/Button.astro";
import SectionHeading from "@studio/core/components/SectionHeading.astro";
import LocationCard from "../components/LocationCard.astro";
import OpenStatus from "../components/OpenStatus.astro";
import WorkspaceInfo from "../components/WorkspaceInfo.astro";
import GalleryStrip from "../components/GalleryStrip.astro";
import FaqList from "../components/FaqList.astro";
import { t, masjid } from "../lib/site";
import { getLocations, formatAddress, openingHours, branchNodes } from "../lib/locations";
import { cafeSchema, faqSchema } from "@studio/core/utils/seo";

const locations = await getLocations();
const primary = locations.find((l) => l.data.primary) ?? locations[0];
const faqs = (await getCollection("faq")).sort((a, b) => a.data.order - b.data.order);

const heroImages = import.meta.glob<{ default: ImageMetadata }>("../assets/images/01-hero*.jpg", {
  eager: true,
});
const hero = Object.values(heroImages)[0]?.default;

const url = new URL("/", Astro.site).toString();
const schema = [
  cafeSchema({
    /* The same id on all three pages: one masjid, one node. Without it,
       three pages describing one masjid are three nodes with the same name,
       address and phone but three different urls, and nothing says they
       are the same place. */
    id: new URL("/#masjid", Astro.site).toString(),
    name: masjid.name,
    /* The description of the MASJID, not of this page. */
    description: t("about.summary"),
    /* The canonical page for the masjid, not the page this markup is on. */
    url: new URL("/", Astro.site).toString(),
    image: new URL("/og.jpg", Astro.site).toString(),
    foundingDate: masjid.foundingYear,
    telephone: masjid.phone,
    email: masjid.email,
    priceRange: masjid.priceRange,
    servesCuisine: masjid.servesCuisine,
    acceptsReservations: false,
    menuUrl: new URL("/jadwal/", Astro.site).toString(),
    streetAddress: primary?.data.streetAddress,
    addressLocality: primary?.data.addressLocality,
    addressRegion: primary?.data.addressRegion,
    postalCode: primary?.data.postalCode,
    addressCountry: primary?.data.addressCountry,
    openingHours: primary ? openingHours(primary) : [],
  }),
  ...branchNodes(locations, Astro.site!.toString(), (i) => cafeSchema(i as never)),
  /* Only when there is something to ask. Emptying the faq folder hid the
     section on the page correctly but still published
     {"@type":"FAQPage","mainEntity":[]} — a declaration with nothing in it. */
  ...(faqs.length
    ? [faqSchema(faqs.map((f) => ({ question: f.data.question, answer: f.data.answer })))]
    : []),
];
---

<BaseLayout title={t("hero.title")} description={t("hero.lead")} schema={schema}>
  {/* Hero: a statement, then the room.

      The first screen is type and nothing else. A cafe visitor is standing on
      the pavement deciding whether to walk in, so the four things they came
      for — the name, where it is, whether it is open, and how to get there —
      are readable before an image has loaded. The photograph earns its place
      immediately after, running the full width of the screen, where it
      answers the fifth question: what it feels like inside. */}
  <section class="hero">
    <Container>
      <div class="hero__grid">
        <div class="hero__content">
          <p class="hero__eyebrow">{t("hero.eyebrow")}</p>
          <h1 class="hero__title">{t("hero.title")}</h1>
          <p class="hero__lead">{t("hero.lead")}</p>
        </div>

        <div class="hero__side">

          {/* Where it is and whether it is open, on the first screen and
              above the photograph. This is the answer a cafe visitor came
              for, and it should not depend on an image having loaded. */}
          {
            primary && (
              <div class="hero__meta">
                <p class="hero__address">{formatAddress(primary)}</p>
                <OpenStatus location={primary} />
              </div>
            )
          }

          {/* One filled action. The menu is a link: a visitor who wants the
              menu will find a link, and a visitor who wants the shop should
              not have to choose between two identical buttons. */}
          <div class="hero__actions">
            {
              primary?.data.mapUrl && (
                <Button
                  href={primary.data.mapUrl}
                  variant="primary"
                  size="lg"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {t("hero.primaryCta")}
                </Button>
              )
            }
            <a class="hero__link" href="/jadwal/">{t("hero.secondaryCta")}</a>
          </div>
        </div>
      </div>

      {/* With a single shop the hero strip is the location, and a card
          underneath repeats the address and the open state word for word.
          With more than one there is something to tell apart, so the cards
          appear then. */}
      {
        locations.length > 1 && (
          <div class="hero__location">
            <SectionHeading
              eyebrow={t("location.eyebrow")}
              title={t("location.title")}
              class="hero__location-heading"
            />
            {locations.map((location) => (
              <LocationCard location={location} headingLevel="h2" />
            ))}
            <p class="hero__all-locations">
              <a href="/contact/">{t("location.viewAll")}</a>
            </p>
          </div>
        )
      }
    </Container>

    {
      hero && (
        <div class="hero__band">
          <CroppedImage
            src={hero}
            alt={t("hero.imageAlt")}
            wide={[3, 1]}
            narrow={[4, 5]}
            sizes="100vw"
            eager
            class="hero__img"
          />
        </div>
      )
    }
  </section>

  {/* Kegiatan mendatang — the agenda the takmir keeps in the panel, read
      from the API in the browser the same way /jadwal/ reads it. The
      section ships a loading line and fills itself in; without JavaScript
      it stays a pointer to the agenda page. */}
  <section class="home-kegiatan" id="kegiatan">
    <Container>
      <SectionHeading
        eyebrow={t("kegiatan.homeEyebrow")}
        title={t("kegiatan.homeTitle")}
        subtitle={t("kegiatan.homeSubtitle")}
      />
      <div class="home-kegiatan__list" id="beranda-kegiatan">
        <p class="home-kegiatan__status">{t("kegiatan.loading")}</p>
      </div>
      <p class="home-kegiatan__cta">
        <Button href="/jadwal/" variant="secondary">{t("kegiatan.homeCta")}</Button>
      </p>
    </Container>
  </section>

  <WorkspaceInfo />

  <GalleryStrip />

  {/* SSS */}
  {
    faqs.length > 0 && (
      <section class="faq-section" id="faq">
        <Container>
          <SectionHeading
            eyebrow={t("faq.eyebrow")}
            title={t("faq.title")}
            subtitle={t("faq.subtitle")}
          />
          <div class="faq-section__list">
            <FaqList items={faqs} />
          </div>
        </Container>
      </section>
    )
  }

  {/* Contact shortcut */}
  <section class="say-hello">
    <Container>
      <div class="say-hello__inner">
        <SectionHeading
          eyebrow={t("contact.eyebrow")}
          title={t("contact.title")}
          subtitle={t("contact.subtitle")}
        />
        <div class="say-hello__actions">
          <Button href="/contact/" variant="primary">{t("contact.form.submit")}</Button>
          {primary && <p class="say-hello__address">{formatAddress(primary)}</p>}
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  import { getAllKegiatan, type Kegiatan } from "../lib/api";
  import { t } from "../lib/site";

  const listHost = document.getElementById("beranda-kegiatan");
  if (listHost) {
    const utcDay = (iso: string) => new Date(`${iso.slice(0, 10)}T00:00:00Z`);
    const dayNum = new Intl.DateTimeFormat("id-ID", { day: "numeric", timeZone: "UTC" });
    const monthShort = new Intl.DateTimeFormat("id-ID", { month: "short", timeZone: "UTC" });

    const clock = (day: string, waktu: string) => {
      const at = new Date(`${day.slice(0, 10)}T${waktu}Z`);
      return `${at.getUTCHours().toString().padStart(2, "0")}.${at
        .getUTCMinutes()
        .toString()
        .padStart(2, "0")}`;
    };

    function element(tag: string, className?: string, text?: string): HTMLElement {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    function card(k: Kegiatan): HTMLElement {
      const link = element("a", "home-kegiatan__card") as HTMLAnchorElement;
      link.href = `/jadwal/${encodeURIComponent(k.slug)}/`;

      const date = element(
        "span",
        "home-kegiatan__date",
        `${dayNum.format(utcDay(k.tanggal_mulai))} ${monthShort.format(utcDay(k.tanggal_mulai))}`
      );
      const name = element("span", "home-kegiatan__name", k.nama_kegiatan);
      const meta = element(
        "span",
        "home-kegiatan__meta",
        `${clock(k.tanggal_mulai, k.waktu_mulai)} ${t("kegiatan.wib")} · ${k.lokasi}`
      );

      link.append(date, name, meta);
      return link;
    }

    (async () => {
      try {
        const agenda = await getAllKegiatan();
        const upcoming = agenda.data
          .filter((k) => k.status === "akan_datang" || k.status === "berlangsung")
          .sort((a, b) =>
            `${a.tanggal_mulai.slice(0, 10)}T${a.waktu_mulai}`.localeCompare(
              `${b.tanggal_mulai.slice(0, 10)}T${b.waktu_mulai}`
            )
          )
          .slice(0, 3);

        if (upcoming.length === 0) {
          listHost.replaceChildren(element("p", "home-kegiatan__status", t("kegiatan.homeEmpty")));
          return;
        }

        listHost.replaceChildren(...upcoming.map(card));
      } catch {
        listHost.replaceChildren(element("p", "home-kegiatan__status", t("kegiatan.error")));
      }
    })();
  }
</script>

<style is:global>
  /* Global, not scoped: the cards are built by the script above. */
  .home-kegiatan {
    padding-block: var(--ts-section-y);
    background: var(--ts-surface-alt);
  }
  .home-kegiatan__list {
    margin-top: var(--ts-space-10);
    display: grid;
    gap: var(--ts-space-4);
  }
  @media (min-width: 768px) {
    .home-kegiatan__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .home-kegiatan__card {
    display: flex;
    flex-direction: column;
    gap: var(--ts-space-2);
    padding: var(--ts-space-5);
    border: 1px solid var(--ts-border);
    border-radius: var(--ts-radius-lg);
    background: var(--ts-c-card-bg);
    text-decoration: none;
  }
  .home-kegiatan__card:hover {
    border-color: var(--ts-border-strong);
  }
  .home-kegiatan__card:focus-visible {
    outline: none;
    box-shadow: var(--ts-focus-ring);
  }
  .home-kegiatan__date {
    font-size: var(--ts-text-xs);
    font-weight: var(--ts-weight-medium);
    letter-spacing: var(--ts-tracking-wide);
    text-transform: uppercase;
    color: var(--ts-text-subtle);
  }
  .home-kegiatan__name {
    font-family: var(--ts-font-display);
    font-size: var(--ts-text-lg);
    font-weight: var(--ts-weight-semibold);
    line-height: var(--ts-leading-snug);
    color: var(--ts-text);
  }
  .home-kegiatan__meta {
    font-size: var(--ts-text-sm);
    color: var(--ts-text-muted);
  }
  .home-kegiatan__status {
    margin: 0;
    font-size: var(--ts-text-sm);
    color: var(--ts-text-muted);
  }
  .home-kegiatan__cta {
    margin: var(--ts-space-10) 0 0;
  }
</style>

<style>
  .hero {
    padding-top: var(--ts-space-16);
  }
  @media (min-width: 768px) {
    .hero {
      padding-top: var(--ts-space-24);
    }
  }
  /* The statement and the practical detail sit side by side, unevenly. The
     heading gets the room; the address, the open state and the way in get a
     narrower column so they read as a block rather than as a tail on the end
     of the paragraph. */
  .hero__grid {
    display: grid;
    gap: var(--ts-space-10);
  }
  @media (min-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
      gap: var(--ts-space-16);
      align-items: end;
    }
  }
  .hero__eyebrow {
    margin: 0 0 var(--ts-space-4);
    font-size: var(--larkin-label-size);
    font-weight: var(--ts-weight-medium);
    letter-spacing: var(--larkin-label-tracking);
    text-transform: uppercase;
    color: var(--ts-text-subtle);
  }
  .hero__title {
    margin: 0;
    font-family: var(--ts-font-display);
    font-size: var(--ts-text-display);
    /* Bold, like every h2 and the about page's h1. At 500 the largest heading
       on the site was the lightest one. */
    font-weight: var(--ts-weight-bold);
    line-height: var(--ts-leading-display);
    letter-spacing: var(--ts-tracking-tight);
    color: var(--ts-text);
    /* Not `ch`. That unit is the width of the "0" glyph, so it is the one
       length that changes when the webfont replaces the fallback face - the
       title fell from two lines to one and everything under it jumped 64px
       (measured). A rem is the same length in both faces. */
    max-width: 41rem;
    text-wrap: balance;
  }
  .hero__lead {
    margin: var(--ts-space-6) 0 0;
    font-size: var(--ts-text-lg);
    line-height: var(--ts-leading-snug);
    color: var(--ts-text-muted);
    max-width: var(--ts-prose-max);
  }
  /* A rule above, not a bar beside. The keyline separates the practical block
     from the sentence above it without pretending to be a card. */
  .hero__side {
    display: flex;
    flex-direction: column;
    /* A grid item defaults to its content width and refuses to shrink; at
       200% text this column overflowed its container. */
    min-width: 0;
  }
  .hero__meta {
    display: flex;
    flex-direction: column;
    gap: var(--ts-space-2);
    padding-top: var(--ts-space-5);
    border-top: 1px solid var(--ts-border-strong);
  }
  .hero__address {
    margin: 0;
    font-size: var(--ts-text-sm);
    color: var(--ts-text-muted);
  }
  .hero__actions {
    margin-top: var(--ts-space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ts-space-6);
  }
  .hero__link {
    color: var(--ts-text);
    font-size: var(--ts-text-base);
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--ts-border-strong);
    transition: text-decoration-color var(--ts-duration-fast) var(--ts-ease-out);
  }
  .hero__link:hover {
    text-decoration-color: var(--ts-text);
  }
  /* Edge to edge. Inside the container the same photograph reads as an
     illustration of the sentence above it; at full width it reads as the
     room. */
  .hero__band {
    margin-top: var(--ts-space-16);
  }
  /* The shape is cut into the file at build time — one crop for each screen,
     one download. The CSS only has to stop it stretching.
     Reached through the band with :global, because the img is rendered by
     CroppedImage and never carries this page's scope attribute: the old
     `.hero__img` rule matched nothing, the photograph fell back to its
     1920px file width and, on a 2560px screen, sat against the left edge
     with 640px of empty page to its right. */
  .hero__band :global(picture),
  .hero__band :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  /* One column per shop from 640px up. The block only renders with more
     than one location, so a single card never sits in a grid. */
  .hero__location {
    margin-top: var(--ts-section-y);
    display: grid;
    gap: var(--ts-space-3);
    grid-template-columns: minmax(0, 1fr);
    max-width: 32rem;
  }
  @media (min-width: 640px) {
    .hero__location {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 52rem;
    }
    .hero__all-locations {
      grid-column: 1 / -1;
    }
    .hero__location-heading {
      grid-column: 1 / -1;
    }
  }
  .hero__all-locations {
    margin: 0;
    font-size: var(--ts-text-sm);
  }
  /* One link treatment across the site: ink with a muted underline. The
     accent is kept for the seasonal mark and the current page. */
  .hero__all-locations a {
    color: var(--ts-text);
    text-decoration: underline;
    text-decoration-color: var(--ts-text-muted);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  .faq-section {
    padding-block: var(--ts-section-y);
  }
  .faq-section__list {
    margin-top: var(--ts-space-10);
  }
  
  .faq-section__list :global(.faq) {
    max-width: none;
  }

  .say-hello {
    padding-block: var(--ts-section-y);
    background: var(--ts-surface-alt);
  }
  .say-hello__inner {
    max-width: 46rem;
  }
  .say-hello__actions {
    margin-top: var(--ts-space-8);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ts-space-6);
  }
  .say-hello__address {
    margin: 0;
    font-size: var(--ts-text-sm);
    color: var(--ts-text-muted);
  }
</style>
