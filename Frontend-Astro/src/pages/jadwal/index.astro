---
import { MENU_CATEGORIES } from "../../content.config";
/**
 * Jadwal — one page with sticky category navigation.
 * The jadwal structured data is built from the collection, so the markup
 * and the machine-readable jadwal cannot disagree.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "@studio/core/components/Container.astro";
import SectionHeading from "@studio/core/components/SectionHeading.astro";
import MenuList from "../../components/MenuList.astro";
import { t } from "../../lib/site";
import { menuSchema } from "@studio/core/utils/seo";

const items = (await getCollection("menu")).filter((i) => i.data.available);

/* An empty category takes no room in the sticky nav */
const categories = MENU_CATEGORIES.filter((c) => items.some((i) => i.data.category === c));

const url = new URL("/jadwal/", Astro.site).toString();
const schema = menuSchema(
  categories.map((category) => ({
    name: t(`jadwal.categories.${category}`),
    items: items
      .filter((i) => i.data.category === category)
      .sort((a, b) => a.data.order - b.data.order)
      .map((i) => ({
        name: i.data.name,
        description: i.data.description,
        price: i.data.price,
        currency: i.data.currency,
        tags: i.data.tags,
        seasonal: i.data.seasonal,
      })),
  })),
  url
);

---

<BaseLayout
  title={t("nav.jadwal")}
  description={t("jadwal.pageSubtitle")}
  schema={schema}
>
  <section class="jadwal-page">
    <Container>
      {/* No eyebrow here, deliberately: the page has one strong heading and
           repeating "Waktu Shalat" above it as a kicker would weaken the
           hierarchy rather than reinforce it. */}
      <SectionHeading title={t("jadwal.pageTitle")} subtitle={t("jadwal.pageSubtitle")} level="h1" />

      <nav class="jadwal-page__nav" aria-label={t("jadwal.categoriesNav")}>
        <ul>
          {
            categories.map((category) => (
              <li>
                <a href={`#${category}`}>{t(`jadwal.categories.${category}`)}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="jadwal-page__list">
        {items.length === 0 ? (
          <p class="jadwal-page__empty">{t("jadwal.empty")}</p>
        ) : (
          <MenuList items={items} categories={[...categories]} withAnchors />
        )}
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .jadwal-page {
    padding-block: var(--ts-space-16) var(--ts-section-y);
  }
  .jadwal-page__empty {
    margin-top: var(--ts-space-10);
    color: var(--ts-text-muted);
  }
  .jadwal-page__nav {
    position: sticky;
    top: var(--ts-c-nav-height, 64px);
    z-index: var(--ts-z-sticky);
    margin-top: var(--ts-space-10);
    padding-block: var(--ts-space-3);
    background: color-mix(in srgb, var(--ts-surface) 94%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--ts-border);
  }
  .jadwal-page__nav ul {
    list-style: none;
    display: flex;
    gap: var(--ts-space-1);
    margin: 0;
    padding: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .jadwal-page__nav ul::-webkit-scrollbar {
    display: none;
  }
  .jadwal-page__nav li {
    scroll-snap-align: start;
    flex: 0 0 auto;
  }
  .jadwal-page__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--ts-space-4);
    border-radius: var(--ts-radius-md);
    font-size: var(--ts-text-sm);
    font-weight: var(--ts-weight-medium);
    color: var(--ts-color-primary-700);
    text-decoration: none;
    white-space: nowrap;
  }
  .jadwal-page__nav a:hover {
    background: var(--ts-surface-alt);
    color: var(--ts-color-primary-900);
  }
  .jadwal-page__nav a:focus-visible {
    outline: none;
    box-shadow: var(--ts-focus-ring);
  }
  .jadwal-page__list {
    margin-top: var(--ts-space-12);
    max-width: 44rem;
  }
</style>
